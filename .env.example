# Privvy environment variables
# Copy to .env (or supabase/functions/.env for local `supabase functions serve`)
# and fill in real values. Never commit real secrets.
# In production, set these with `supabase secrets set`.

# --- Gemini (server-side only, never ship to the extension) ---
GEMINI_API_KEY=your-gemini-api-key-here

# Required, no default. Set to a model your Google project can actually access,
# and verify access before relying on it. Example: gemini-2.5-flash
GEMINI_MODEL=

# --- Text length bounds (characters; used by client guard and server cap) ---
MIN_TEXT_CHARS=500
MAX_TEXT_CHARS=100000

# --- Per-IP rate limiting (edge function) ---
# Window duration in seconds; also the TTL for the hashed-IP counter.
RATE_LIMIT_WINDOW=60
# Max requests allowed per IP within the window.
RATE_LIMIT_MAX=10
