{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // normalize.ts uses Web Crypto (`crypto.subtle`) and `TextEncoder`, which are
    // runtime-agnostic globals present in both Deno and the browser. The "DOM" lib
    // provides their type declarations without adding any runtime dependency.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
