{
  "name": "privvy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privvy — a Chrome extension that summarizes privacy policies and terms.",
  "workspaces": [
    "shared",
    "extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
